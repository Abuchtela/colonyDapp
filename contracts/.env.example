# Deployer wallet private key (NEVER commit the real value)
DEPLOYER_PRIVATE_KEY=0x<your-private-key>

# Optional: custom xDai / Gnosis Chain RPC endpoint
# Default: https://rpc.gnosischain.com
XDAI_RPC_URL=https://rpc.gnosischain.com

# Optional: override token metadata at deploy time
TOKEN_NAME=SuperChainerC20 Token
TOKEN_SYMBOL=SCC20
INITIAL_SUPPLY=100000000

# Optional: override the SuperchainTokenBridge predeploy address
SUPERCHAIN_BRIDGE=0x4200000000000000000000000000000000000028

# Optional: set to any non-empty value to enable gas reporting in tests
# REPORT_GAS=1
